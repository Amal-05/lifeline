{
  "openapi": "3.1.0",
  "info": {
    "title": "Lifeline API",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sync": {
      "post": {
        "summary": "Sync",
        "operationId": "sync_api_v1_sync_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SyncBundle"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sync/summary": {
      "get": {
        "summary": "Sync Summary",
        "operationId": "sync_summary_api_v1_sync_summary_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Sync Summary Api V1 Sync Summary Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/media": {
      "post": {
        "summary": "Upload Media",
        "operationId": "upload_media_api_v1_media_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_media_api_v1_media_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MediaAck"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/requests/{request_id}/status": {
      "get": {
        "summary": "Request Status",
        "operationId": "request_status_api_v1_requests__request_id__status_get",
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Request Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Request Status Api V1 Requests  Request Id  Status Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/config": {
      "get": {
        "summary": "Config",
        "operationId": "config_api_v1_config_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Config Api V1 Config Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_upload_media_api_v1_media_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_media_api_v1_media_post"
      },
      "EventEnvelope": {
        "properties": {
          "protocol_version": {
            "type": "integer",
            "title": "Protocol Version",
            "default": 1
          },
          "event_id": {
            "type": "string",
            "title": "Event Id"
          },
          "device_id": {
            "type": "string",
            "title": "Device Id"
          },
          "hlc": {
            "type": "string",
            "title": "Hlc"
          },
          "type": {
            "type": "string",
            "title": "Type"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload"
          },
          "hops": {
            "type": "integer",
            "maximum": 12.0,
            "minimum": 0.0,
            "title": "Hops",
            "default": 0
          },
          "signature": {
            "type": "string",
            "title": "Signature"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "device_id",
          "hlc",
          "type",
          "request_id",
          "payload",
          "signature"
        ],
        "title": "EventEnvelope"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MediaAck": {
        "properties": {
          "media_id": {
            "type": "string",
            "title": "Media Id"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "default": "received"
          }
        },
        "type": "object",
        "required": [
          "media_id"
        ],
        "title": "MediaAck"
      },
      "SyncBundle": {
        "properties": {
          "protocol_version": {
            "type": "integer",
            "title": "Protocol Version",
            "default": 1
          },
          "events": {
            "items": {
              "$ref": "#/components/schemas/EventEnvelope"
            },
            "type": "array",
            "title": "Events"
          },
          "known_event_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Known Event Ids"
          },
          "highest_hlc_by_device": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Highest Hlc By Device"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "events"
        ],
        "title": "SyncBundle"
      },
      "SyncResponse": {
        "properties": {
          "accepted_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Accepted Ids"
          },
          "rejected": {
            "items": {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            "type": "array",
            "title": "Rejected"
          },
          "missing_events": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Missing Events"
          }
        },
        "type": "object",
        "required": [
          "accepted_ids",
          "rejected",
          "missing_events"
        ],
        "title": "SyncResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
